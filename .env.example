# Copy to .env (never commit .env). Keys are read by src/irm/config.py.
# Optional: every offline step (week1, week2, pytest, ask in retrieval-only mode, cached
# Gemini replay) runs WITHOUT a .env file. Keys are only needed for new API calls.
# Model roles: Gemini = OCR / extraction + answers; Claude = independent LLM-as-judge.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Week 1 model-tier comparison candidates - verify the exact IDs in Google AI Studio first.
GEMINI_OCR_CANDIDATES=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-3.1-pro-preview
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_ANSWER_MODEL=gemini-3.1-pro-preview
GEMINI_EMBED_MODEL=gemini-embedding-001
CLAUDE_JUDGE_MODEL=claude-sonnet-5-5
BGE_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional swapped-role experiment (tried in Week 1, NOT adopted): Claude reads/answers, Gemini judges.
#   python run.py extract --provider claude --prompt v1 --set sample
#   python run.py answer-eval --answer-provider claude --judge-provider gemini
CLAUDE_OCR_MODEL=claude-opus-5-5
CLAUDE_ANSWER_MODEL=claude-opus-5-5
GEMINI_JUDGE_MODEL=gemini-2.5-flash

# USD per 1M tokens, copied from the official pricing pages on the day of the run.
# Variable name = PRICE_IN_/PRICE_OUT_ + model id in upper case with - and . replaced by _
PRICE_IN_GEMINI_3_5_FLASH_LITE=
PRICE_OUT_GEMINI_3_5_FLASH_LITE=
PRICE_IN_GEMINI_2_5_FLASH=
PRICE_OUT_GEMINI_2_5_FLASH=
PRICE_IN_GEMINI_3_1_PRO_PREVIEW=
PRICE_OUT_GEMINI_3_1_PRO_PREVIEW=

RENDER_DPI=150
# seconds between Gemini requests (free tier: requests-per-minute limit)
GEMINI_MIN_INTERVAL_S=6
